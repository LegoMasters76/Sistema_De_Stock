# Copy this file to .env for local development. Never commit .env.
DJANGO_ENV=local
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false

# Leave empty locally to use SQLite. Production requires PostgreSQL.
DATABASE_URL=
# Example for PostgreSQL:
# DATABASE_URL=postgresql://stockpro:change-me@localhost:5432/stockpro